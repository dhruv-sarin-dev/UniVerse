# Copy this file to .env and fill in your Firebase project credentials
# Get these from Firebase Console → Project Settings → Your Apps
# NEVER commit .env to Git

VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Your deployed backend URL (e.g. https://uni-verse-backend.onrender.com)
# Must include the scheme. A bare host breaks both fetch and the War Room socket.
VITE_API_URL=https://your-backend.onrender.com

# ── War Room TURN relay ──
# STUN alone only connects peers on forgiving networks. Without a TURN relay,
# calls fail whenever either user is behind a symmetric NAT (most mobile data,
# many campus and corporate networks). Required for reliable production calls.
# Comma-separate to supply several URLs for the same credentials.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
